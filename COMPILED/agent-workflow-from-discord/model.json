    {
      "frame": "04",
      "dataType": "",
      "value": "{\n  classification: llm_judge\n  decision: select one tool from [findInvoices]\n  output: { tool: string, fromDate: date, toDate: date }\n  The result must use only an allowed tool and must not invent arguments.\n}",
      "line": 12
    },
    {
      "frame": "08",
      "dataType": "",
      "value": "{\n  externalSystem: InvoiceRepository\n  timeout: \"30s\"\n  retry: { max: 2, backoff: exponential }\n  Input: conversationId, fromDate, and toDate.\n  Success output: conversationId, count, customers, and empty failureReason.\n  Retry-exhausted output: conversationId, count 0, empty customers, and failureReason repository_unavailable.\n}",
      "line": 28
    },
    {
      "frame": "14",
      "dataType": "",
      "value": "{\n  classification: pure_function\n  Format count and customer names from InvoicesFound.\n  Singular uses \"invoice was\"; plural uses \"invoices were\".\n  Preserve customer order from the event.\n}",
      "line": 45
    },
    {
      "frame": "19",
      "dataType": "",
      "value": "{\n  Support staff review this inbox from their support screen every morning.\n  The morning review is an operator cadence, not a workflow timer.\n}",
      "line": 57
    }
