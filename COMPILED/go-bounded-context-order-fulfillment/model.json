  "notes": [
    {
      "frame": "01",
      "dataType": "",
      "value": "{ hitl: \"checkout_screen\" }",
      "line": 17
    },
    {
      "frame": "03",
      "dataType": "",
      "value": "{\n  The customer picks the payment method on CheckoutScreen.\n  CheckoutScreen assigns orderId when checkout opens; it identifies the\n  order in every context and is the idempotency key for external calls.\n  Total and items come from CartSummary, never from the command.\n}",
      "line": 18
    },
    {
      "frame": "08",
      "dataType": "",
      "value": "{ external_system: \"payment_gateway\", timeout: \"10s\", retry: { max: 3, backoff: exponential }, idempotency_key: \"orderId\", gateway_result: \"approved with authorizationId, or declined with reason\" }",
      "line": 32
    },
    {
      "frame": "13",
      "dataType": "",
      "value": "{ external_system: \"warehouse_inventory\", timeout: \"30s\", retry: { max: 3, backoff: exponential }, idempotency_key: \"orderId plus allocation attempt number\", inventory_result: \"allocated with shipmentId and warehouseId, or unavailable with missingSkus\" }",
      "line": 43
    },
    {
      "frame": "26",
      "dataType": "",
      "value": "{\n  Re-issue AllocateShipment only when the replenished sku is one of the\n  missingSkus of the deferred order; the warehouse chooses where to allocate.\n}",
      "line": 46
    }
  ],
