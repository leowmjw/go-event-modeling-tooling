eventmodeling

// End-of-day payment settlement reconciliation.
//
// Every evening the scheme sends a settlement file listing what actually
// cleared for our participant BIC. Finance compares it line by line with the
// day's internal ledger postings. Items that agree are "matched"; everything
// else is a "break" that a Reconciliation Analyst must classify, park in
// suspense, chase, and ultimately resolve or - with Finance Controller
// approval under maker-checker - write off. The day cannot be closed while
// breaks are unaccounted for. Target: 95%+ auto-match.
//
// Sample data deliberately reuses payment pay-7f3a9c / SCT-INST-9A81C2 from
// fintech-instant-payment-v2.evml: the "late ACCP after timeout" hotspot in
// that model shows up here as a MISSING_INTERNAL break (brk-0002).
//
// Stages: everything current except
//   * tolerance-based auto-clear of differences under EUR 0.50  → staging
//   * ML-suggested break classification                          → future

actor ReconciliationAnalyst
actor FinanceController

chapter "Ingest settlement file" 01-04
chapter "Ingest ledger postings" 05-08
chapter "Auto-matching" 09-17
chapter "Break investigation" 18-29
chapter "Aging and escalation" 30-33
chapter "Write-off (maker-checker)" 34-42
chapter "Finance close-out" 43-46

slice "Import scheme settlement file" 01-04 status Done
slice "Import ledger postings" 05-08 status Done
slice "Exact match on reference" 09-12 status Done
slice "Fuzzy match on amount and value date" 13-14 status Done
slice "Raise breaks for leftovers" 15-17 status Done
slice "Breaks queue" 18-18 status Done
slice "ML-suggested classification" 19-21 status Planned stage future
slice "Classify break" 22-24 status Done
slice "Post to suspense" 25-26 status Done
slice "Tolerance auto-clear under 0.50" 27-29 status Review stage staging
slice "Age and escalate" 30-33 status Done
slice "Propose write-off (maker)" 34-36 status Done
slice "Approve write-off (checker)" 37-39 status Done
slice "Post write-off" 40-42 status Done
slice "Close the reconciliation day" 43-46 status Done

// ── Ingest settlement file ───────────────────────────────────────────────────
rf 01 evt Scheme.SettlementFileReceived { fileId: "SCTINST-NWBKGB2L-20250612-EOD", participantBic: "NWBKGB2L", valueDate: "2025-06-12", recordCount: 1891, controlTotalDebit: 412870.55, controlTotalCredit: 388120.10, currency: "EUR", sha256: "9c1f...e2a7", receivedAt: "2025-06-12T22:05:14Z" }
tf 02 pcr SettlementFileTranslator ->> 01
tf 03 cmd ImportSettlementFile { fileId: "SCTINST-NWBKGB2L-20250612-EOD", valueDate: "2025-06-12", recordCount: 1891, controlTotalDebit: 412870.55, controlTotalCredit: 388120.10, currency: "EUR" }
tf 04 evt SettlementFileImported [[SettlementFileImported04]]

// ── Ingest ledger postings ───────────────────────────────────────────────────
rf 05 evt Ledger.DayPostingsClosed { ledgerDate: "2025-06-12", nostroAccount: "NOSTRO-SCTINST-EUR", postingCount: 1888, totalDebit: 412792.35, totalCredit: 388120.10, currency: "EUR", closedAt: "2025-06-12T22:00:00Z" }
tf 06 pcr LedgerPostingsTranslator ->> 05
tf 07 cmd ImportLedgerPostings { ledgerDate: "2025-06-12", nostroAccount: "NOSTRO-SCTINST-EUR", postingCount: 1888, currency: "EUR" }
tf 08 evt LedgerPostingsImported [[LedgerPostingsImported08]]

// ── Auto-matching ────────────────────────────────────────────────────────────
tf 09 rmo UnmatchedItems ->> 04 ->> 08 [[UnmatchedItems09]]
tf 10 pcr AutoMatcher ->> 09
tf 11 cmd MatchByReference { reconRunId: "run-20250612-01", valueDate: "2025-06-12", externalItemId: "ext-000173", internalItemId: "int-88213", matchKey: "E2E-20250612-000173" }
tf 12 evt ItemsMatchedByReference { reconRunId: "run-20250612-01", matchId: "m-000001", externalItemId: "ext-000173", internalItemId: "int-88213", matchKey: "E2E-20250612-000173", amount: 250.00, currency: "EUR", matchedAt: "2025-06-12T22:06:01Z" }
tf 13 cmd MatchByAmountAndDate ->> 10 { reconRunId: "run-20250612-01", externalItemId: "ext-001204", internalItemId: "int-88240", amount: 1200.00, currency: "EUR", externalValueDate: "2025-06-13", internalPostingDate: "2025-06-12", dateToleranceDays: 1 }
tf 14 evt ItemsMatchedByAmountAndDate { reconRunId: "run-20250612-01", matchId: "m-001204", externalItemId: "ext-001204", internalItemId: "int-88240", amount: 1200.00, currency: "EUR", dateDifferenceDays: 1, matchedAt: "2025-06-12T22:06:03Z" }
tf 15 cmd RaiseBreak ->> 10 { reconRunId: "run-20250612-01", breakId: "brk-0002", detectedType: "EXTERNAL_ONLY", externalItemId: "ext-001590", externalReference: "SCT-INST-1F44B0", amount: 78.20, currency: "EUR", valueDate: "2025-06-12" }
tf 16 evt BreakRaised { reconRunId: "run-20250612-01", breakId: "brk-0002", detectedType: "EXTERNAL_ONLY", externalItemId: "ext-001590", externalReference: "SCT-INST-1F44B0", amount: 78.20, currency: "EUR", valueDate: "2025-06-12", raisedAt: "2025-06-12T22:06:09Z" }
tf 17 rmo MatchRateSummary ->> 12 ->> 14 ->> 16 [[MatchRateSummary17]]

// ── Break investigation ──────────────────────────────────────────────────────
tf 18 rmo BreaksQueue ->> 16 [[BreaksQueue18]]

tf 19 pcr BreakClassifierModel ->> 18
tf 20 cmd SuggestBreakClassification { breakId: "brk-0002", modelVersion: "recon-cls-2025.08", suggestedClassification: "MISSING_INTERNAL", confidence: 0.87, topFeatures: ["external_only", "late_accp_flag", "amount_lt_100"] }
tf 21 evt BreakClassificationSuggested { breakId: "brk-0002", modelVersion: "recon-cls-2025.08", suggestedClassification: "MISSING_INTERNAL", confidence: 0.87, suggestedAt: "2025-06-12T22:06:12Z" }

tf 22 ui BreakInvestigationDesk @ReconciliationAnalyst
tf 23 cmd ClassifyBreak { breakId: "brk-0002", classification: "MISSING_INTERNAL", rootCause: "LATE_SCHEME_ACCP_AFTER_TIMEOUT", linkedPaymentId: "pay-7f3a9c", analystId: "ra-0141", comment: "Scheme settled 3.3 s after our 10 s watchdog reversed the hold; no debit posted." }
tf 24 evt BreakClassified { breakId: "brk-0002", classification: "MISSING_INTERNAL", rootCause: "LATE_SCHEME_ACCP_AFTER_TIMEOUT", linkedPaymentId: "pay-7f3a9c", amount: 78.20, currency: "EUR", analystId: "ra-0141", classifiedAt: "2025-06-13T08:12:40Z" }
tf 25 cmd PostToSuspense { breakId: "brk-0002", suspenseAccount: "SUSP-RECON-4711", direction: "DEBIT", amount: 78.20, currency: "EUR", analystId: "ra-0141" }
tf 26 evt PostedToSuspense { breakId: "brk-0002", suspenseAccount: "SUSP-RECON-4711", journalEntryId: "je-20250613-00417", direction: "DEBIT", amount: 78.20, currency: "EUR", postedAt: "2025-06-13T08:13:02Z" }

tf 27 pcr ToleranceAutoClearer ->> 18
tf 28 cmd AutoClearSmallDifference { breakId: "brk-0007", detectedType: "AMOUNT_DIFFERENCE", externalAmount: 499.88, internalAmount: 500.00, difference: 0.12, currency: "EUR", tolerance: 0.50, writeOffAccount: "PL-BANK-CHARGES-6120" }
tf 29 evt SmallDifferenceAutoCleared { breakId: "brk-0007", difference: 0.12, currency: "EUR", tolerance: 0.50, writeOffAccount: "PL-BANK-CHARGES-6120", journalEntryId: "je-20250612-00902", clearedAt: "2025-06-12T22:06:15Z" }

// ── Aging and escalation ─────────────────────────────────────────────────────
tf 30 rmo AgedBreaks ->> 16 ->> 24 ->> 26 [[AgedBreaks30]]
tf 31 pcr BreakAgingProcessor ->> 30
tf 32 cmd EscalateBreak { breakId: "brk-0002", ageBusinessDays: 5, escalationThresholdDays: 5, escalateTo: "FinanceController", amount: 78.20, currency: "EUR" }
tf 33 evt BreakEscalated { breakId: "brk-0002", ageBusinessDays: 5, escalatedTo: "FinanceController", escalationLevel: 1, escalatedAt: "2025-06-19T07:00:00Z" }

// ── Write-off (maker-checker) ────────────────────────────────────────────────
tf 34 ui WriteOffProposalScreen @ReconciliationAnalyst
tf 35 cmd ProposeWriteOff { breakId: "brk-0002", proposalId: "wo-0031", amount: 78.20, currency: "EUR", suspenseAccount: "SUSP-RECON-4711", writeOffAccount: "PL-RECON-LOSSES-6150", justification: "Beneficiary bank confirms funds credited to customer; recall declined (CUST). Unrecoverable.", proposedBy: "ra-0141" }
tf 36 evt WriteOffProposed { breakId: "brk-0002", proposalId: "wo-0031", amount: 78.20, currency: "EUR", writeOffAccount: "PL-RECON-LOSSES-6150", proposedBy: "ra-0141", proposedAt: "2025-06-20T10:41:00Z" }
tf 37 ui WriteOffApprovalDesk @FinanceController
tf 38 cmd ApproveWriteOff { proposalId: "wo-0031", breakId: "brk-0002", amount: 78.20, currency: "EUR", approvedBy: "fc-0002", approverLimit: 5000.00 }
tf 39 evt WriteOffApproved { proposalId: "wo-0031", breakId: "brk-0002", amount: 78.20, currency: "EUR", proposedBy: "ra-0141", approvedBy: "fc-0002", approvedAt: "2025-06-20T14:05:30Z" }
tf 40 pcr WriteOffPostingProcessor ->> 39
tf 41 cmd PostWriteOff { proposalId: "wo-0031", breakId: "brk-0002", fromAccount: "SUSP-RECON-4711", toAccount: "PL-RECON-LOSSES-6150", amount: 78.20, currency: "EUR" }
tf 42 evt WriteOffPosted { proposalId: "wo-0031", breakId: "brk-0002", journalEntryId: "je-20250620-00188", fromAccount: "SUSP-RECON-4711", toAccount: "PL-RECON-LOSSES-6150", amount: 78.20, currency: "EUR", postedAt: "2025-06-20T14:05:32Z" }

// ── Finance close-out ────────────────────────────────────────────────────────
tf 43 rmo ReconciliationCloseOutReport ->> 12 ->> 16 ->> 26 ->> 29 ->> 42 [[ReconciliationCloseOutReport43]]
tf 44 ui CloseOutDashboard @FinanceController
tf 45 cmd CloseReconciliationDay { valueDate: "2025-06-12", reconRunId: "run-20250612-01", closedBy: "fc-0002", openBreaks: 0, breaksInSuspense: 1, autoMatchRate: 0.9741 }
tf 46 evt ReconciliationDayClosed { valueDate: "2025-06-12", reconRunId: "run-20250612-01", matchedItems: 1842, autoMatchRate: 0.9741, breaksRaised: 49, breaksResolved: 47, breaksInSuspense: 1, writtenOff: 1, writtenOffAmount: 78.20, currency: "EUR", closedBy: "fc-0002", closedAt: "2025-06-20T16:30:00Z" }

