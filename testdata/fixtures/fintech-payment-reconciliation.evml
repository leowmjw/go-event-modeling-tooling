    { breakId: "brk-0007", detectedType: "AMOUNT_DIFFERENCE", externalAmount: 499.88, internalAmount: 500.00, difference: 0.12, currency: "EUR", valueDate: "2025-06-12", ageBusinessDays: 0, status: "OPEN" }
    { breakId: "brk-0011", detectedType: "POSSIBLE_DUPLICATE", internalItemIds: ["int-88377", "int-88378"], amount: 2500.00, currency: "EUR", valueDate: "2025-06-12", ageBusinessDays: 0, status: "OPEN" }
