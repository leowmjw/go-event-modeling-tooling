eventmodeling

// Correctly modeled business process with explicit bounded-context boundaries.
// Main user flow stays inside Sales until a durable fact crosses into another
// context through a reset frame. Every context closes each branch it touches.

entity Order

// ── Sales bounded context ────────────────────────────────────────────────────
tf 01 ui CheckoutScreen ->> 02
rf 21 evt Pricing.CartPriced { cartId: "c-100", customerId: "cust-7", items: [{ sku: "sku-1", qty: 1, unitPrice: 75.00 }, { sku: "sku-2", qty: 1, unitPrice: 50.00 }], total: 125.00 }
tf 02 rmo CartSummary ->> 21 [[CartSummary02]]
tf 03 cmd PlaceOrder ->> 01 { orderId: "ord-100", cartId: "c-100", customerId: "cust-7", paymentMethodId: "pm-9" }
tf 04 evt OrderPlaced ->> 03 [[OrderPlaced04]]
tf 27 evt OrderPlacementRejected ->> 03 { orderId: "ord-100", cartId: "c-100", reason: "empty_cart" }
tf 05 rmo OrderStatus ->> 04 ->> 33 ->> 19 [[OrderStatus05]]
note 01 { hitl: "checkout_screen" }
note 03 {
  The customer picks the payment method on CheckoutScreen.
  CheckoutScreen assigns orderId when checkout opens; it identifies the
  order in every context and is the idempotency key for external calls.
  Total and items come from CartSummary, never from the command.
}

// ── Billing bounded context ──────────────────────────────────────────────────
rf 06 evt Sales.OrderPlaced { orderId: "ord-100", paymentMethodId: "pm-9", total: 125.00 }
tf 07 pcr BillingTranslator ->> 06
tf 08 cmd AuthorizePayment ->> 07 { orderId: "ord-100", amount: 125.00, paymentMethodId: "pm-9" }
tf 09 evt PaymentAuthorized ->> 08 { orderId: "ord-100", authorizationId: "auth-1", amount: 125.00 }
tf 22 evt PaymentDeclined ->> 08 { orderId: "ord-100", reason: "insufficient_funds" }
tf 10 rmo PaymentStatus ->> 09 ->> 22 { orderId: "ord-100", status: "authorized" }
note 08 { external_system: "payment_gateway", timeout: "10s", retry: { max: 3, backoff: exponential }, idempotency_key: "orderId", gateway_result: "approved with authorizationId, or declined with reason" }

// ── Fulfillment bounded context ──────────────────────────────────────────────
rf 28 evt Sales.OrderPlaced { orderId: "ord-100", items: [{ sku: "sku-1", qty: 1 }, { sku: "sku-2", qty: 1 }] }
rf 11 evt Billing.PaymentAuthorized { orderId: "ord-100", amount: 125.00 }
tf 29 rmo PaidOrdersToShip ->> 28 ->> 11 [[PaidOrdersToShip29]]
tf 12 pcr FulfillmentTranslator ->> 29
tf 13 cmd AllocateShipment ->> 12 ->> 26 { orderId: "ord-100", items: [{ sku: "sku-1", qty: 1 }, { sku: "sku-2", qty: 1 }] }
tf 14 evt ShipmentAllocated ->> 13 { orderId: "ord-100", shipmentId: "sh-55", warehouseId: "wh-1" }
tf 23 evt ShipmentAllocationDeferred ->> 13 { orderId: "ord-100", reason: "inventory_unavailable", missingSkus: ["sku-1"] }
tf 15 rmo ShipmentQueue ->> 14 ->> 23 [[ShipmentQueue15]]
note 13 { external_system: "warehouse_inventory", timeout: "30s", retry: { max: 3, backoff: exponential }, idempotency_key: "orderId plus allocation attempt number", inventory_result: "allocated with shipmentId and warehouseId, or unavailable with missingSkus" }
rf 25 evt Warehouse.InventoryReplenished { warehouseId: "wh-1", sku: "sku-1" }
tf 26 pcr AllocationRetrier ->> 25 ->> 23 ->> 29
note 26 {
  Re-issue AllocateShipment only when the replenished sku is one of the
  missingSkus of the deferred order; the warehouse chooses where to allocate.
}

// ── Sales: billing failure recovery ──────────────────────────────────────────
rf 16 evt Billing.PaymentDeclined { orderId: "ord-100", reason: "insufficient_funds" }
tf 17 pcr SalesRecoveryTranslator ->> 16
tf 18 cmd CancelOrder ->> 17 { orderId: "ord-100", reason: "payment_declined" }
tf 19 evt OrderCancelled ->> 18 { orderId: "ord-100", reason: "payment_declined" }
tf 24 evt OrderCancellationIgnored ->> 18 { orderId: "ord-100", reason: "already_cancelled" }

// ── Sales: payment confirmation ──────────────────────────────────────────────
rf 30 evt Billing.PaymentAuthorized { orderId: "ord-100", authorizationId: "auth-1" }
tf 31 pcr SalesConfirmationTranslator ->> 30
tf 32 cmd ConfirmOrder ->> 31 { orderId: "ord-100", authorizationId: "auth-1" }
tf 33 evt OrderConfirmed ->> 32 { orderId: "ord-100", authorizationId: "auth-1" }
tf 34 evt OrderConfirmationIgnored ->> 32 { orderId: "ord-100", reason: "already_confirmed" }

data CartSummary02 {
  cartId: "c-100"
  customerId: "cust-7"
  items: [
    { sku: "sku-1", qty: 1, unitPrice: 75.00 }
    { sku: "sku-2", qty: 1, unitPrice: 50.00 }
  ]
  total: 125.00
}

data OrderPlaced04 {
  orderId: "ord-100"
  cartId: "c-100"
  customerId: "cust-7"
  paymentMethodId: "pm-9"
  items: [
    { sku: "sku-1", qty: 1, unitPrice: 75.00 }
    { sku: "sku-2", qty: 1, unitPrice: 50.00 }
  ]
  total: 125.00
}

data OrderStatus05 {
  orderId: "ord-100"
  customerId: "cust-7"
  status: "pending_payment"
}

data PaidOrdersToShip29 {
  orderId: "ord-100"
  items: [
    { sku: "sku-1", qty: 1 }
    { sku: "sku-2", qty: 1 }
  ]
  status: "ready_to_ship"
}

data ShipmentQueue15 {
  shipmentId: "sh-55"
  orderId: "ord-100"
  warehouseId: "wh-1"
  status: "queued_for_picking"
}

gwt 03 "place order from a priced cart"
  given
    evt Pricing.CartPriced { cartId: "c-100", customerId: "cust-7", items: [{ sku: "sku-1", qty: 1, unitPrice: 75.00 }, { sku: "sku-2", qty: 1, unitPrice: 50.00 }], total: 125.00 }
  when
    cmd PlaceOrder { orderId: "ord-100", cartId: "c-100", customerId: "cust-7", paymentMethodId: "pm-9" }
  then
    evt OrderPlaced { orderId: "ord-100", cartId: "c-100", customerId: "cust-7", paymentMethodId: "pm-9", items: [{ sku: "sku-1", qty: 1, unitPrice: 75.00 }, { sku: "sku-2", qty: 1, unitPrice: 50.00 }], total: 125.00 }

gwt 03 "reject order when cart has no priced items"
  given
    evt Pricing.CartPriced { cartId: "c-100", customerId: "cust-7", items: [], total: 0.00 }
  when
    cmd PlaceOrder { orderId: "ord-100", cartId: "c-100", customerId: "cust-7", paymentMethodId: "pm-9" }
  then
    evt OrderPlacementRejected { orderId: "ord-100", cartId: "c-100", reason: "empty_cart" }

gwt 05 "order awaits payment once placed"
  given
    evt OrderPlaced { orderId: "ord-100", customerId: "cust-7" }
  then
    rmo OrderStatus { orderId: "ord-100", customerId: "cust-7", status: "pending_payment" }

gwt 05 "order is confirmed after payment is authorized"
  given
    evt OrderPlaced { orderId: "ord-100", customerId: "cust-7" }
    evt OrderConfirmed { orderId: "ord-100", authorizationId: "auth-1" }
  then
    rmo OrderStatus { orderId: "ord-100", customerId: "cust-7", status: "confirmed" }

gwt 05 "order is cancelled after payment declines"
  given
    evt OrderPlaced { orderId: "ord-100", customerId: "cust-7" }
    evt OrderCancelled { orderId: "ord-100", reason: "payment_declined" }
  then
    rmo OrderStatus { orderId: "ord-100", customerId: "cust-7", status: "cancelled" }

gwt 08 "authorize payment when the gateway approves the charge"
  given
    evt Sales.OrderPlaced { orderId: "ord-100", paymentMethodId: "pm-9", total: 125.00 }
  when
    cmd AuthorizePayment { orderId: "ord-100", amount: 125.00, paymentMethodId: "pm-9" }
  then
    evt PaymentAuthorized { orderId: "ord-100", authorizationId: "auth-1", amount: 125.00 }

gwt 08 "decline payment when the gateway declines the charge"
  given
    evt Sales.OrderPlaced { orderId: "ord-100", paymentMethodId: "pm-9", total: 125.00 }
  when
    cmd AuthorizePayment { orderId: "ord-100", amount: 125.00, paymentMethodId: "pm-9" }
  then
    evt PaymentDeclined { orderId: "ord-100", reason: "insufficient_funds" }

gwt 10 "payment status shows an authorized payment"
  given
    evt PaymentAuthorized { orderId: "ord-100", authorizationId: "auth-1", amount: 125.00 }
  then
    rmo PaymentStatus { orderId: "ord-100", status: "authorized" }

gwt 10 "payment status shows a declined payment"
  given
    evt PaymentDeclined { orderId: "ord-100", reason: "insufficient_funds" }
  then
    rmo PaymentStatus { orderId: "ord-100", status: "declined", reason: "insufficient_funds" }

gwt 29 "paid order is ready to ship"
  given
    evt Sales.OrderPlaced { orderId: "ord-100", items: [{ sku: "sku-1", qty: 1 }, { sku: "sku-2", qty: 1 }] }
    evt Billing.PaymentAuthorized { orderId: "ord-100", amount: 125.00 }
  then
    rmo PaidOrdersToShip { orderId: "ord-100", items: [{ sku: "sku-1", qty: 1 }, { sku: "sku-2", qty: 1 }], status: "ready_to_ship" }

gwt 29 "unpaid order is not ready to ship"
  given
    evt Sales.OrderPlaced { orderId: "ord-100", items: [{ sku: "sku-1", qty: 1 }, { sku: "sku-2", qty: 1 }] }
  then
    rmo PaidOrdersToShip { orderId: "ord-100", items: [{ sku: "sku-1", qty: 1 }, { sku: "sku-2", qty: 1 }], status: "awaiting_payment" }

gwt 13 "allocate shipment when inventory is available"
  given
    evt Sales.OrderPlaced { orderId: "ord-100", items: [{ sku: "sku-1", qty: 1 }, { sku: "sku-2", qty: 1 }] }
    evt Billing.PaymentAuthorized { orderId: "ord-100", amount: 125.00 }
  when
    cmd AllocateShipment { orderId: "ord-100", items: [{ sku: "sku-1", qty: 1 }, { sku: "sku-2", qty: 1 }] }
  then
    evt ShipmentAllocated { orderId: "ord-100", shipmentId: "sh-55", warehouseId: "wh-1" }

gwt 13 "defer shipment when inventory is not available"
  given
    evt Sales.OrderPlaced { orderId: "ord-100", items: [{ sku: "sku-1", qty: 1 }, { sku: "sku-2", qty: 1 }] }
    evt Billing.PaymentAuthorized { orderId: "ord-100", amount: 125.00 }
  when
    cmd AllocateShipment { orderId: "ord-100", items: [{ sku: "sku-1", qty: 1 }, { sku: "sku-2", qty: 1 }] }
  then
    evt ShipmentAllocationDeferred { orderId: "ord-100", reason: "inventory_unavailable", missingSkus: ["sku-1"] }

gwt 15 "allocated shipment is queued for picking"
  given
    evt ShipmentAllocated { orderId: "ord-100", shipmentId: "sh-55", warehouseId: "wh-1" }
  then
    rmo ShipmentQueue { shipmentId: "sh-55", orderId: "ord-100", warehouseId: "wh-1", status: "queued_for_picking" }

gwt 15 "deferred shipment awaits inventory"
  given
    evt ShipmentAllocationDeferred { orderId: "ord-100", reason: "inventory_unavailable", missingSkus: ["sku-1"] }
  then
    rmo ShipmentQueue { orderId: "ord-100", status: "awaiting_inventory", missingSkus: ["sku-1"] }

gwt 26 "retry allocation when a missing sku is replenished"
  given
    evt Sales.OrderPlaced { orderId: "ord-100", items: [{ sku: "sku-1", qty: 1 }, { sku: "sku-2", qty: 1 }] }
    evt ShipmentAllocationDeferred { orderId: "ord-100", reason: "inventory_unavailable", missingSkus: ["sku-1"] }
    evt Warehouse.InventoryReplenished { warehouseId: "wh-1", sku: "sku-1" }
  then
    cmd AllocateShipment { orderId: "ord-100", items: [{ sku: "sku-1", qty: 1 }, { sku: "sku-2", qty: 1 }] }

gwt 26 "keep waiting when an unrelated sku is replenished"
  given
    evt ShipmentAllocationDeferred { orderId: "ord-100", reason: "inventory_unavailable", missingSkus: ["sku-1"] }
    evt Warehouse.InventoryReplenished { warehouseId: "wh-1", sku: "sku-9" }
  then
    rmo ShipmentQueue { orderId: "ord-100", status: "awaiting_inventory", missingSkus: ["sku-1"] }

gwt 18 "cancel order after payment declines"
  given
    evt OrderPlaced { orderId: "ord-100", customerId: "cust-7" }
  when
    cmd CancelOrder { orderId: "ord-100", reason: "payment_declined" }
  then
    evt OrderCancelled { orderId: "ord-100", reason: "payment_declined" }

gwt 18 "ignore cancellation when order is already cancelled"
  given
    evt OrderPlaced { orderId: "ord-100", customerId: "cust-7" }
    evt OrderCancelled { orderId: "ord-100", reason: "payment_declined" }
  when
    cmd CancelOrder { orderId: "ord-100", reason: "payment_declined" }
  then
    evt OrderCancellationIgnored { orderId: "ord-100", reason: "already_cancelled" }

gwt 32 "confirm order after payment is authorized"
  given
    evt OrderPlaced { orderId: "ord-100", customerId: "cust-7" }
  when
    cmd ConfirmOrder { orderId: "ord-100", authorizationId: "auth-1" }
  then
    evt OrderConfirmed { orderId: "ord-100", authorizationId: "auth-1" }

gwt 32 "ignore confirmation when order is already confirmed"
  given
    evt OrderPlaced { orderId: "ord-100", customerId: "cust-7" }
    evt OrderConfirmed { orderId: "ord-100", authorizationId: "auth-1" }
  when
    cmd ConfirmOrder { orderId: "ord-100", authorizationId: "auth-1" }
  then
    evt OrderConfirmationIgnored { orderId: "ord-100", reason: "already_confirmed" }
