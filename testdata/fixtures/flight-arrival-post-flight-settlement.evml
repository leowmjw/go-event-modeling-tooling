eventmodeling

// Flight Arrival & Post-Flight Settlement
//
// Bounded contexts (left → right across time):
//   Operations  →  Compensation  →  Finance  →  Marketing
//
// Ubiquitous language disambiguation:
//   "On-Time Arrival" in Operations  = wheels-down timestamp
//   "On-Time Arrival" in Compensation = gate-door-open timestamp
//   "Customer" in Finance             = entity with a billable account
//   "Customer" in Marketing           = anyone who visited the booking page
//
// Translation processors at every context boundary prevent context collapse.
// Every workflow branch terminates with an explicit recorded outcome (Process
// View: State Change → Outcome).  State History is preserved for all
// transitions including eligibility checks, payout reversals, and offer
// responses (Data Model View: Previous State, New State, Transition Time).

// ── Operations bounded context ───────────────────────────────────────────────
tf 01 ui FlightDeck
tf 02 rmo FlightStatus [[FlightStatus02]]
tf 03 cmd RecordWheelsDown { flightId: "HLT-421", wheelsTouchTime: "2024-06-15T14:32:00Z", aircraftId: "N42HL" }
tf 04 evt WheelsDownRecorded { flightId: "HLT-421", wheelsTouchTime: "2024-06-15T14:32:00Z", aircraftId: "N42HL", boundedContext: "Operations" }
tf 05 cmd RecordGateArrival { flightId: "HLT-421", gateDoorOpenTime: "2024-06-15T14:47:00Z", gateId: "B12" }
tf 06 evt GateOpened { flightId: "HLT-421", gateDoorOpenTime: "2024-06-15T14:47:00Z", gateId: "B12", boundedContext: "Operations" }
tf 07 rmo ArrivalBoard [[ArrivalBoard07]]

// ── Compensation bounded context ─────────────────────────────────────────────
// suppress it when the flight is already on time (rules/decisions guide
// transitions — Workflow Execution box in the diagram).
rf 08 evt Operations.GateOpened { flightId: "HLT-421", gateDoorOpenTime: "2024-06-15T14:47:00Z" }
tf 09 pcr CompensationProcessor ->> 08
tf 10 cmd EvaluateDelay { flightId: "HLT-421", scheduledArrival: "2024-06-15T14:30:00Z", actualArrivalTime: "2024-06-15T14:47:00Z", onTimeDefinition: "gate_door_open" }
tf 11 evt DelayEvaluated { flightId: "HLT-421", delayMinutes: 17, isDelayed: true, onTimeThresholdMinutes: 15, boundedContext: "Compensation" }

// that "eligible → ineligible" is a recorded state transition in State History.
tf 12 cmd VerifyPassengerEligibility { flightId: "HLT-421", passengerIds: ["pax-1", "pax-2", "pax-3"] }
tf 13 evt PassengerEligibilityVerified { flightId: "HLT-421", eligibleIds: ["pax-1", "pax-2", "pax-3"], ineligibleIds: [] }
tf 14 cmd CalculateCompensation { flightId: "HLT-421", delayMinutes: 17, eligiblePassengerIds: ["pax-1", "pax-2", "pax-3"] }
tf 15 evt CompensationCalculated { flightId: "HLT-421", totalCompensationAmount: 510.00, perPassengerAmount: 170.00, currency: "USD", eligiblePassengerIds: ["pax-1", "pax-2", "pax-3"] }
tf 16 rmo DelayClaimSummary [[DelayClaimSummary16]]

// flights so its own state history is complete (no dangling open case).
rf 17 evt Operations.FlightClosedOnTime { flightId: "HLT-421", closedAt: "2024-06-15T14:28:00Z" }
tf 18 pcr CompensationClosureProcessor ->> 17
tf 19 cmd CloseCompensationCase { flightId: "HLT-421", reason: "on_time_no_claim" }
tf 20 evt CompensationCaseClosed { flightId: "HLT-421", reason: "on_time_no_claim", closedAt: "2024-06-15T14:30:00Z" }
tf 21 rmo ClosedClaimRecord { flightId: "HLT-421", status: "closed_no_claim" }

// ── Finance bounded context ──────────────────────────────────────────────────
rf 22 evt Compensation.CompensationCalculated { flightId: "HLT-421", totalCompensationAmount: 510.00, eligiblePassengerIds: ["pax-1", "pax-2", "pax-3"] }
tf 23 pcr FinanceTranslator ->> 22
tf 24 cmd ApproveDisbursement { flightId: "HLT-421", totalAmount: 510.00, billingAccountIds: ["acc-pax1", "acc-pax2", "acc-pax3"], customerDefinition: "billable_account" }
tf 25 evt DisbursementApproved { flightId: "HLT-421", disbursementId: "disb-9901", totalAmount: 510.00, approvedAt: "2024-06-15T15:10:00Z", boundedContext: "Finance" }
tf 26 cmd IssuePayout { disbursementId: "disb-9901", paymentRails: "ACH", scheduledDate: "2024-06-16" }
tf 27 evt PayoutIssued { disbursementId: "disb-9901", paymentRails: "ACH", scheduledDate: "2024-06-16", totalAmount: 510.00 }
tf 28 rmo FinanceSettlementReport [[FinanceSettlementReport28]]

// transition PayoutIssued → PayoutFailed → PayoutReversed in State History.
rf 29 evt Finance.PayoutFailed { disbursementId: "disb-9901", failureCode: "R03", totalAmount: 510.00 }
tf 30 pcr PayoutRecoveryProcessor ->> 29
tf 31 cmd ReverseAndReissuePayout { disbursementId: "disb-9901", newPaymentRails: "WIRE", scheduledDate: "2024-06-17" }
tf 32 evt PayoutReversed { disbursementId: "disb-9901", failureCode: "R03", reversedAt: "2024-06-16T09:00:00Z" }
tf 33 evt PayoutReissued { disbursementId: "disb-9901", newPaymentRails: "WIRE", scheduledDate: "2024-06-17", totalAmount: 510.00 }
tf 34 rmo PayoutRecoveryReport { disbursementId: "disb-9901", status: "reissued_via_wire", scheduledDate: "2024-06-17" }

// when only a subset of passengers has a billable account, so Compensation can
// record the unresolved portion as a separate state transition.
rf 35 evt Finance.PartialDisbursementRejected { flightId: "HLT-421", rejectedPassengerIds: ["pax-3"], rejectedAmount: 170.00, reason: "no_billable_account" }
tf 36 pcr CompensationRecoveryTranslator ->> 35
tf 37 cmd EscalateUnresolvedClaim { flightId: "HLT-421", passengerIds: ["pax-3"], amount: 170.00 }
tf 38 evt ClaimEscalated { flightId: "HLT-421", passengerIds: ["pax-3"], amount: 170.00, escalatedAt: "2024-06-16T10:00:00Z" }
tf 39 rmo EscalatedClaimsQueue { flightId: "HLT-421", pendingPassengers: ["pax-3"], pendingAmount: 170.00 }

// ── Marketing bounded context ─────────────────────────────────────────────────
rf 40 evt Finance.PayoutIssued { disbursementId: "disb-9901", flightId: "HLT-421", totalAmount: 510.00 }
tf 41 pcr MarketingTranslator ->> 40
tf 42 cmd TagDelayedTravelers { flightId: "HLT-421", travelerIds: ["visitor-a", "visitor-b", "visitor-c"], segmentTag: "delayed_flight_2024_06", customerDefinition: "booking_page_visitor" }
tf 43 evt DelayedTravelerTagged { flightId: "HLT-421", segmentTag: "delayed_flight_2024_06", travelerCount: 3 }
tf 44 cmd SendRecoveryOffer { segmentTag: "delayed_flight_2024_06", offerId: "offer-77", channel: "email" }
tf 45 evt RecoveryOfferSent { segmentTag: "delayed_flight_2024_06", offerId: "offer-77", sentAt: "2024-06-15T16:00:00Z" }
tf 46 rmo MarketingCampaignDashboard [[MarketingCampaignDashboard46]]

// relationship in the Data Model View).  RecoveryOfferAccepted and
// RecoveryOfferDeclined are distinct terminal outcomes that must be recorded.
tf 47 ui RecoveryOfferResponseScreen
tf 48 cmd RespondToRecoveryOffer { offerId: "offer-77", travelerId: "visitor-a", response: "accepted" }
tf 49 evt RecoveryOfferAccepted { offerId: "offer-77", travelerId: "visitor-a", acceptedAt: "2024-06-15T17:05:00Z" }
tf 50 rmo MarketingConversionReport { offerId: "offer-77", acceptedCount: 1, declinedCount: 0 }

// ── No-delay path: Operations closes, then notifies Compensation (Gap-1) ─────
rf 51 evt Operations.WheelsDownRecorded { flightId: "HLT-421", wheelsTouchTime: "2024-06-15T14:28:00Z" }
tf 52 pcr OntimeVerifier ->> 51
tf 53 cmd CloseFlightOnTime { flightId: "HLT-421", closedAt: "2024-06-15T14:28:00Z", reason: "on_time_wheels_down" }
tf 54 evt FlightClosedOnTime { flightId: "HLT-421", closedAt: "2024-06-15T14:28:00Z" }
tf 55 rmo FlightClosureRecord { flightId: "HLT-421", status: "on_time", closedAt: "2024-06-15T14:28:00Z" }

data FlightStatus02 {
  flightId: "HLT-421"
  origin: "JFK"
  destination: "LAX"
  scheduledArrival: "2024-06-15T14:30:00Z"
  currentStatus: "in_flight"
  aircraftId: "N42HL"
}

data ArrivalBoard07 {
  flightId: "HLT-421"
  gateId: "B12"
  gateDoorOpenTime: "2024-06-15T14:47:00Z"
  displayStatus: "ARRIVED"
}

data DelayClaimSummary16 {
  flightId: "HLT-421"
  delayMinutes: 17
  eligiblePassengers: [
    { passengerId: "pax-1", compensationAmount: 170.00 }
    { passengerId: "pax-2", compensationAmount: 170.00 }
    { passengerId: "pax-3", compensationAmount: 170.00 }
  ]
  ineligiblePassengers: []
  totalCompensation: 510.00
  currency: "USD"
  status: "pending_disbursement"
}

data FinanceSettlementReport28 {
  disbursementId: "disb-9901"
  flightId: "HLT-421"
  totalAmount: 510.00
  paymentRails: "ACH"
  scheduledDate: "2024-06-16"
  status: "approved"
  billingAccounts: [
    { accountId: "acc-pax1", amount: 170.00 }
    { accountId: "acc-pax2", amount: 170.00 }
    { accountId: "acc-pax3", amount: 170.00 }
  ]
}

data MarketingCampaignDashboard46 {
  segmentTag: "delayed_flight_2024_06"
  activeCampaigns: 1
  targetedTravelers: 3
  offersSent: 3
  offersAccepted: 0
  offersDeclined: 0
  conversionRate: 0.00
}

// ── GWT scenarios ─────────────────────────────────────────────────────────────

gwt 03 "record wheels-down for an in-flight aircraft"
  given
    evt FlightDeparted { flightId: "HLT-421", origin: "JFK" }
  when
    cmd RecordWheelsDown { flightId: "HLT-421", wheelsTouchTime: "2024-06-15T14:32:00Z", aircraftId: "N42HL" }
  then
    evt WheelsDownRecorded { flightId: "HLT-421", wheelsTouchTime: "2024-06-15T14:32:00Z" }

gwt 03 "reject duplicate wheels-down recording"
  given
    evt WheelsDownRecorded { flightId: "HLT-421", wheelsTouchTime: "2024-06-15T14:32:00Z" }
  when
    cmd RecordWheelsDown { flightId: "HLT-421", wheelsTouchTime: "2024-06-15T14:33:00Z", aircraftId: "N42HL" }
  then
    evt WheelsDownRejected { flightId: "HLT-421", reason: "already_recorded" }

gwt 05 "record gate arrival after wheels-down"
  given
    evt WheelsDownRecorded { flightId: "HLT-421", wheelsTouchTime: "2024-06-15T14:32:00Z" }
  when
    cmd RecordGateArrival { flightId: "HLT-421", gateDoorOpenTime: "2024-06-15T14:47:00Z", gateId: "B12" }
  then
    evt GateOpened { flightId: "HLT-421", gateDoorOpenTime: "2024-06-15T14:47:00Z", gateId: "B12" }

gwt 05 "reject gate arrival without prior wheels-down"
  given
    evt FlightDeparted { flightId: "HLT-421", origin: "JFK" }
  when
    cmd RecordGateArrival { flightId: "HLT-421", gateDoorOpenTime: "2024-06-15T14:47:00Z", gateId: "B12" }
  then
    evt GateArrivalRejected { flightId: "HLT-421", reason: "wheels_down_not_recorded" }

gwt 10 "evaluate as delayed when gate-door time exceeds threshold (Compensation context)"
  given
    evt Operations.GateOpened { flightId: "HLT-421", gateDoorOpenTime: "2024-06-15T14:47:00Z" }
  when
    cmd EvaluateDelay { flightId: "HLT-421", scheduledArrival: "2024-06-15T14:30:00Z", actualArrivalTime: "2024-06-15T14:47:00Z", onTimeDefinition: "gate_door_open" }
  then
    evt DelayEvaluated { flightId: "HLT-421", delayMinutes: 17, isDelayed: true }

gwt 10 "evaluate as on-time when gate-door time is within threshold"
  given
    evt Operations.GateOpened { flightId: "HLT-421", gateDoorOpenTime: "2024-06-15T14:44:00Z" }
  when
    cmd EvaluateDelay { flightId: "HLT-421", scheduledArrival: "2024-06-15T14:30:00Z", actualArrivalTime: "2024-06-15T14:44:00Z", onTimeDefinition: "gate_door_open" }
  then
    evt DelayEvaluated { flightId: "HLT-421", delayMinutes: 14, isDelayed: false }

gwt 12 "verify all passengers eligible for compensation"
  given
    evt DelayEvaluated { flightId: "HLT-421", delayMinutes: 17, isDelayed: true }
  when
    cmd VerifyPassengerEligibility { flightId: "HLT-421", passengerIds: ["pax-1", "pax-2", "pax-3"] }
  then
    evt PassengerEligibilityVerified { flightId: "HLT-421", eligibleIds: ["pax-1", "pax-2", "pax-3"], ineligibleIds: [] }

gwt 12 "mark passenger ineligible when already compensated for this flight"
  given
    evt CompensationCalculated { flightId: "HLT-421", eligiblePassengerIds: ["pax-3"] }
  when
    cmd VerifyPassengerEligibility { flightId: "HLT-421", passengerIds: ["pax-3"] }
  then
    evt PassengerEligibilityVerified { flightId: "HLT-421", eligibleIds: [], ineligibleIds: ["pax-3"] }

gwt 14 "calculate compensation for eligible passengers"
  given
    evt PassengerEligibilityVerified { flightId: "HLT-421", eligibleIds: ["pax-1", "pax-2", "pax-3"], ineligibleIds: [] }
  when
    cmd CalculateCompensation { flightId: "HLT-421", delayMinutes: 17, eligiblePassengerIds: ["pax-1", "pax-2", "pax-3"] }
  then
    evt CompensationCalculated { flightId: "HLT-421", totalCompensationAmount: 510.00, perPassengerAmount: 170.00 }

gwt 09 "CompensationProcessor suppresses EvaluateDelay for on-time arrivals"
  given
    evt Operations.GateOpened { flightId: "HLT-421", gateDoorOpenTime: "2024-06-15T14:44:00Z" }
  when
    cmd EvaluateDelay { flightId: "HLT-421", scheduledArrival: "2024-06-15T14:30:00Z", actualArrivalTime: "2024-06-15T14:44:00Z", onTimeDefinition: "gate_door_open" }
  then
    evt DelayEvaluationSuppressed { flightId: "HLT-421", reason: "within_on_time_threshold", delayMinutes: 14 }

gwt 24 "approve disbursement for billable account holders (Finance context)"
  given
    evt Compensation.CompensationCalculated { flightId: "HLT-421", totalCompensationAmount: 510.00 }
  when
    cmd ApproveDisbursement { flightId: "HLT-421", totalAmount: 510.00, billingAccountIds: ["acc-pax1", "acc-pax2", "acc-pax3"], customerDefinition: "billable_account" }
  then
    evt DisbursementApproved { flightId: "HLT-421", disbursementId: "disb-9901", totalAmount: 510.00 }

gwt 24 "partially reject disbursement for passengers without billable accounts"
  given
    evt Compensation.CompensationCalculated { flightId: "HLT-421", totalCompensationAmount: 510.00 }
  when
    cmd ApproveDisbursement { flightId: "HLT-421", totalAmount: 510.00, billingAccountIds: ["acc-pax1", "acc-pax2"], customerDefinition: "billable_account" }
  then
    evt PartialDisbursementRejected { flightId: "HLT-421", rejectedPassengerIds: ["pax-3"], rejectedAmount: 170.00, reason: "no_billable_account" }

gwt 24 "reject full disbursement when no billable account exists"
  given
    evt Compensation.CompensationCalculated { flightId: "HLT-421", totalCompensationAmount: 170.00 }
  when
    cmd ApproveDisbursement { flightId: "HLT-421", totalAmount: 170.00, billingAccountIds: [], customerDefinition: "billable_account" }
  then
    evt DisbursementRejected { flightId: "HLT-421", reason: "no_billable_account" }

gwt 26 "issue payout via ACH after disbursement approval"
  given
    evt DisbursementApproved { disbursementId: "disb-9901", totalAmount: 510.00 }
  when
    cmd IssuePayout { disbursementId: "disb-9901", paymentRails: "ACH", scheduledDate: "2024-06-16" }
  then
    evt PayoutIssued { disbursementId: "disb-9901", totalAmount: 510.00, scheduledDate: "2024-06-16" }

gwt 26 "reject payout when disbursement is not yet approved"
  given
    evt Compensation.CompensationCalculated { flightId: "HLT-421", totalCompensationAmount: 510.00 }
  when
    cmd IssuePayout { disbursementId: "disb-9901", paymentRails: "ACH", scheduledDate: "2024-06-16" }
  then
    evt PayoutRejected { disbursementId: "disb-9901", reason: "disbursement_not_approved" }

gwt 31 "reverse and reissue payout after ACH return (R03)"
  given
    evt Finance.PayoutFailed { disbursementId: "disb-9901", failureCode: "R03" }
  when
    cmd ReverseAndReissuePayout { disbursementId: "disb-9901", newPaymentRails: "WIRE", scheduledDate: "2024-06-17" }
  then
    evt PayoutReversed { disbursementId: "disb-9901", failureCode: "R03" }

gwt 31 "reject reissuance when disbursement is already reversed"
  given
    evt PayoutReversed { disbursementId: "disb-9901", failureCode: "R03" }
  when
    cmd ReverseAndReissuePayout { disbursementId: "disb-9901", newPaymentRails: "WIRE", scheduledDate: "2024-06-17" }
  then
    evt PayoutReversalRejected { disbursementId: "disb-9901", reason: "already_reversed" }

gwt 37 "escalate unresolved claim for passenger without billable account"
  given
    evt Finance.PartialDisbursementRejected { flightId: "HLT-421", rejectedPassengerIds: ["pax-3"], rejectedAmount: 170.00 }
  when
    cmd EscalateUnresolvedClaim { flightId: "HLT-421", passengerIds: ["pax-3"], amount: 170.00 }
  then
    evt ClaimEscalated { flightId: "HLT-421", passengerIds: ["pax-3"], amount: 170.00 }

gwt 37 "reject escalation when claim is already escalated"
  given
    evt ClaimEscalated { flightId: "HLT-421", passengerIds: ["pax-3"], amount: 170.00 }
  when
    cmd EscalateUnresolvedClaim { flightId: "HLT-421", passengerIds: ["pax-3"], amount: 170.00 }
  then
    evt ClaimEscalationRejected { flightId: "HLT-421", reason: "already_escalated" }

gwt 42 "tag delayed travelers as booking-page visitors (Marketing context)"
  given
    evt Finance.PayoutIssued { disbursementId: "disb-9901", flightId: "HLT-421" }
  when
    cmd TagDelayedTravelers { flightId: "HLT-421", travelerIds: ["visitor-a", "visitor-b", "visitor-c"], segmentTag: "delayed_flight_2024_06", customerDefinition: "booking_page_visitor" }
  then
    evt DelayedTravelerTagged { flightId: "HLT-421", segmentTag: "delayed_flight_2024_06", travelerCount: 3 }

gwt 42 "skip tagging when no visitors match the flight"
  given
    evt Finance.PayoutIssued { disbursementId: "disb-9901", flightId: "HLT-421" }
  when
    cmd TagDelayedTravelers { flightId: "HLT-421", travelerIds: [], segmentTag: "delayed_flight_2024_06", customerDefinition: "booking_page_visitor" }
  then
    evt TravelerTaggingSkipped { flightId: "HLT-421", reason: "no_matching_visitors" }

gwt 48 "traveler accepts recovery offer"
  given
    evt RecoveryOfferSent { offerId: "offer-77", segmentTag: "delayed_flight_2024_06" }
  when
    cmd RespondToRecoveryOffer { offerId: "offer-77", travelerId: "visitor-a", response: "accepted" }
  then
    evt RecoveryOfferAccepted { offerId: "offer-77", travelerId: "visitor-a" }

gwt 48 "traveler declines recovery offer"
  given
    evt RecoveryOfferSent { offerId: "offer-77", segmentTag: "delayed_flight_2024_06" }
  when
    cmd RespondToRecoveryOffer { offerId: "offer-77", travelerId: "visitor-b", response: "declined" }
  then
    evt RecoveryOfferDeclined { offerId: "offer-77", travelerId: "visitor-b" }

gwt 19 "close compensation case when flight is confirmed on time"
  given
    evt Operations.FlightClosedOnTime { flightId: "HLT-421", closedAt: "2024-06-15T14:28:00Z" }
  when
    cmd CloseCompensationCase { flightId: "HLT-421", reason: "on_time_no_claim" }
  then
    evt CompensationCaseClosed { flightId: "HLT-421", reason: "on_time_no_claim" }

gwt 19 "reject closure when compensation case is already closed"
  given
    evt CompensationCaseClosed { flightId: "HLT-421", reason: "on_time_no_claim" }
  when
    cmd CloseCompensationCase { flightId: "HLT-421", reason: "on_time_no_claim" }
  then
    evt CompensationCaseClosureRejected { flightId: "HLT-421", reason: "already_closed" }

gwt 53 "close flight on-time via wheels-down path"
  given
    evt Operations.WheelsDownRecorded { flightId: "HLT-421", wheelsTouchTime: "2024-06-15T14:28:00Z" }
  when
    cmd CloseFlightOnTime { flightId: "HLT-421", closedAt: "2024-06-15T14:28:00Z", reason: "on_time_wheels_down" }
  then
    evt FlightClosedOnTime { flightId: "HLT-421", closedAt: "2024-06-15T14:28:00Z" }

gwt 53 "reject closure when wheels-down is missing"
  given
    evt FlightDeparted { flightId: "HLT-421", origin: "JFK" }
  when
    cmd CloseFlightOnTime { flightId: "HLT-421", closedAt: "2024-06-15T14:28:00Z", reason: "on_time_wheels_down" }
  then
    evt FlightClosureRejected { flightId: "HLT-421", reason: "wheels_down_not_recorded" }
