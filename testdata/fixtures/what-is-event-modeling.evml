eventmodeling

// Hotel Booking System - https://eventmodeling.org/posts/what-is-event-modeling/
//
// Colors rendered by the SVG renderer:
//   ui  (wireframe screens) -> salmon   #f8d4bc / #d38e5f
//   cmd (commands)          -> blue     #bcd6fe / #679ac3
//   evt (events)            -> green    #d3f1a2 / #84af49
//   rmo (read models)       -> blue     #bcd6fe / #679ac3
//   pcr (processors)        -> salmon   #f8d4bc / #d38e5f

tf 01 ui SearchRoomsScreen
tf 02 cmd SearchRooms { roomType: "double", checkIn: "2024-06-01", checkOut: "2024-06-05" }
tf 03 evt RoomsSearched { roomType: "double", checkIn: "2024-06-01", checkOut: "2024-06-05", rooms: [{ id: "r-42", type: "double", price: 100 }, { id: "r-55", type: "double", price: 110 }], available: 2 }
tf 04 rmo RoomList [[RoomList04]]

tf 05 ui BookRoomScreen
tf 06 cmd BookRoom { bookingId: "b-1", roomId: "r-42", guestId: "g-7", checkIn: "2024-06-01", checkOut: "2024-06-05" }
tf 07 evt RoomBooked [[RoomBooked07]]
tf 08 rmo BookingConfirmation [[Confirmation08]]

tf 09 ui CheckInDesk
tf 10 cmd CheckIn { bookingId: "b-1" }
tf 11 evt GuestCheckedIn { bookingId: "b-1", roomId: "r-42" }
tf 12 rmo RoomStatus { status: "occupied" }

tf 13 ui CheckOutDesk
tf 14 cmd CheckOut { bookingId: "b-1" }
tf 15 evt GuestCheckedOut { bookingId: "b-1", nights: 4, nightlyRate: 100, amount: 400 }
tf 16 pcr BillingProcessor ->> 15
tf 17 cmd TakePayment { bookingId: "b-1", nights: 4, amount: 400 }
tf 18 evt PaymentTaken { bookingId: "b-1", nights: 4, amount: 400 }
tf 19 rmo Invoice [[Invoice19]]

data RoomList04 {
  rooms: [
    { id: "r-42", type: "double", price: 100 }
    { id: "r-55", type: "double", price: 110 }
  ]
}

data RoomBooked07 {
  bookingId: "b-1"
  roomId: "r-42"
  guestId: "g-7"
  checkIn: "2024-06-01"
  checkOut: "2024-06-05"
}

data Confirmation08 {
  bookingId: "b-1"
  roomId: "r-42"
  checkIn: "2024-06-01"
  checkOut: "2024-06-05"
}

data Invoice19 {
  bookingId: "b-1"
  nights: 4
  amount: 400
}

gwt 02 "search available rooms"
  given
    evt HotelInventoryLoaded { hotelId: "hotel-1" }
  when
    cmd SearchRooms { roomType: "double", checkIn: "2024-06-01", checkOut: "2024-06-05" }
  then
    evt RoomsSearched { roomType: "double", checkIn: "2024-06-01", checkOut: "2024-06-05", rooms: [{ id: "r-42", type: "double", price: 100 }, { id: "r-55", type: "double", price: 110 }], available: 2 }

gwt 06 "book available room"
  given
    evt RoomsSearched { roomType: "double", checkIn: "2024-06-01", checkOut: "2024-06-05", rooms: [{ id: "r-42", type: "double", price: 100 }], available: 1 }
  when
    cmd BookRoom { bookingId: "b-1", roomId: "r-42", guestId: "g-7", checkIn: "2024-06-01", checkOut: "2024-06-05" }
  then
    evt RoomBooked { bookingId: "b-1", roomId: "r-42", guestId: "g-7", checkIn: "2024-06-01", checkOut: "2024-06-05" }

gwt 06 "reject unavailable room"
  given
    evt RoomsSearched { roomType: "double", checkIn: "2024-06-01", checkOut: "2024-06-05", rooms: [], available: 0 }
  when
    cmd BookRoom { bookingId: "b-2", roomId: "r-42", guestId: "g-8", checkIn: "2024-06-01", checkOut: "2024-06-05" }
  then
    evt RoomBookingRejected { bookingId: "b-2", roomId: "r-42", reason: "room_unavailable" }

gwt 10 "check in guest"
  given
    evt RoomBooked { bookingId: "b-1", roomId: "r-42", guestId: "g-7", checkIn: "2024-06-01", checkOut: "2024-06-05" }
  when
    cmd CheckIn { bookingId: "b-1" }
  then
    evt GuestCheckedIn { bookingId: "b-1", roomId: "r-42" }

gwt 10 "reject duplicate check in"
  given
    evt GuestCheckedIn { bookingId: "b-1", roomId: "r-42" }
  when
    cmd CheckIn { bookingId: "b-1" }
  then
    evt GuestCheckInRejected { bookingId: "b-1", reason: "already_checked_in" }

gwt 14 "check out a checked-in guest"
  given
    evt GuestCheckedIn { bookingId: "b-1", roomId: "r-42" }
  when
    cmd CheckOut { bookingId: "b-1" }
  then
    evt GuestCheckedOut { bookingId: "b-1", nights: 4, nightlyRate: 100, amount: 400 }

gwt 14 "reject checkout before check in"
  given
    evt RoomBooked { bookingId: "b-1", roomId: "r-42", guestId: "g-7", checkIn: "2024-06-01", checkOut: "2024-06-05" }
  when
    cmd CheckOut { bookingId: "b-1" }
  then
    evt GuestCheckOutRejected { bookingId: "b-1", reason: "not_checked_in" }

gwt 16 "prepare payment from checkout totals"
  given
    evt GuestCheckedOut { bookingId: "b-1", nights: 4, nightlyRate: 100, amount: 400 }
  when
    cmd TakePayment { bookingId: "b-1", nights: 4, amount: 400 }
  then
    evt PaymentRequested { bookingId: "b-1", nights: 4, amount: 400 }

gwt 17 "payment on check out"
  given
    evt GuestCheckedOut { bookingId: "b-1", nights: 4, nightlyRate: 100, amount: 400 }
  when
    cmd TakePayment { bookingId: "b-1", nights: 4, amount: 400 }
  then
    evt PaymentTaken { bookingId: "b-1", nights: 4, amount: 400 }

gwt 17 "reject non-positive payment"
  given
    evt GuestCheckedOut { bookingId: "b-1", nights: 4, nightlyRate: 100, amount: 400 }
  when
    cmd TakePayment { bookingId: "b-1", nights: 4, amount: 0 }
  then
    evt PaymentRejected { bookingId: "b-1", reason: "amount_must_be_positive" }
