eventmodeling

// Double-entry ledger with end-of-day settlement: every business fact posts
// a balanced journal, corrections reverse instead of editing, settlement
// lines must match or route to suspense. FUTURE: multi-currency revaluation
// postings.
tf 01 ui LedgerOpsScreen
tf 02 cmd CreateAccount { accountId: "cash-1", currency: "USD" }
tf 03 evt AccountCreated { accountId: "cash-1", currency: "USD" }
tf 04 pcr JournalValidator ->> 03
tf 05 cmd PostJournal { journalId: "j-900", debit: "cash-1", credit: "revenue-1", amountMinor: 25000 }
tf 06 evt JournalPosted { journalId: "j-900", debit: "cash-1", credit: "revenue-1", amountMinor: 25000 }
tf 07 rmo TrialBalance [[Trial07]]
tf 08 pcr SettlementRunner ->> 06
tf 09 cmd RunEndOfDaySettlement { batchId: "set-2026-09-15" }
tf 10 evt SettlementBatchOpened { batchId: "set-2026-09-15" }
tf 11 pcr Matcher ->> 10
tf 12 cmd MarkSettlementMatched { batchId: "set-2026-09-15", journalId: "j-900" }
tf 13 evt SettlementLineMatched { batchId: "set-2026-09-15", journalId: "j-900" }
tf 14 rmo SettlementBatchView { batchId: "set-2026-09-15", matched: 1, breaks: 0 }

rf 15 evt Payments.SettlementLineMismatch { batchId: "set-2026-09-15", journalId: "j-901" }
tf 16 pcr BreakRouter ->> 15
tf 17 cmd ResolveBreak { batchId: "set-2026-09-15", journalId: "j-901", route: "suspense" }
tf 18 evt SettlementBreakDetected { batchId: "set-2026-09-15", journalId: "j-901" }
tf 19 rmo BreaksDashboard { batchId: "set-2026-09-15", openBreaks: 1 }
tf 20 pcr ReversalPoster ->> 18
tf 21 cmd ReverseJournal { journalId: "j-901", reason: "duplicate_posting" }
tf 22 evt JournalReversed { journalId: "j-901", reversalId: "j-902" }

data Trial07 {
  batchId: "set-2026-09-15"
  debitsMinor: 25000
  creditsMinor: 25000
}

note 05 { NEXT: reject unbalanced journals at post time with the exact out-of-balance amount. }
note 17 { FUTURE: multi-currency journals with an FX revaluation posting leg. }

gwt 05 "post a balanced journal"
  given
    evt AccountCreated { accountId: "cash-1", currency: "USD" }
  when
    cmd PostJournal { journalId: "j-900", debit: "cash-1", credit: "revenue-1", amountMinor: 25000 }
  then
    evt JournalPosted { journalId: "j-900", debit: "cash-1", credit: "revenue-1", amountMinor: 25000 }

gwt 05 "reject an unbalanced journal"
  given
    evt AccountCreated { accountId: "cash-1", currency: "USD" }
  when
    cmd PostJournal { journalId: "j-900", debit: "cash-1", credit: "revenue-1", amountMinor: 25001 }
  then
    evt JournalRejectedUnbalanced { journalId: "j-900", reason: "out_of_balance" }

gwt 09 "open the end-of-day batch after posting"
  given
    evt JournalPosted { journalId: "j-900", debit: "cash-1", credit: "revenue-1", amountMinor: 25000 }
  when
    cmd RunEndOfDaySettlement { batchId: "set-2026-09-15" }
  then
    evt SettlementBatchOpened { batchId: "set-2026-09-15" }

gwt 12 "match a settlement line to its journal"
  given
    evt SettlementBatchOpened { batchId: "set-2026-09-15" }
  when
    cmd MarkSettlementMatched { batchId: "set-2026-09-15", journalId: "j-900" }
  then
    evt SettlementLineMatched { batchId: "set-2026-09-15", journalId: "j-900" }

gwt 17 "route a mismatched line to suspense"
  given
    evt Payments.SettlementLineMismatch { batchId: "set-2026-09-15", journalId: "j-901" }
  when
    cmd ResolveBreak { batchId: "set-2026-09-15", journalId: "j-901", route: "suspense" }
  then
    evt SettlementBreakDetected { batchId: "set-2026-09-15", journalId: "j-901" }

gwt 21 "reverse a duplicate posting instead of editing"
  given
    evt SettlementBreakDetected { batchId: "set-2026-09-15", journalId: "j-901" }
  when
    cmd ReverseJournal { journalId: "j-901", reason: "duplicate_posting" }
  then
    evt JournalReversed { journalId: "j-901", reversalId: "j-902" }
